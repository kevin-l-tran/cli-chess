GameControls {
    height: 5;
    width: 1fr;
    min-width: 62;
}

GameControls .action-row {
    height: 1;
    width: 1fr;
    align: center middle;
    margin: 0 0 1 0;
}

GameControls .action-button {
    width: auto;
    min-width: 14;
    height: 1;
    margin: 0 2;
    padding: 0;
    border: none;
    background: $background;
    color: $foreground;
    content-align: center middle;
    text-style: bold;
}

GameControls .action-button:hover {
    color: $accent;
}

GameControls .action-button:focus {
    color: $foreground;
    background: $surface;
    text-style: bold reverse;
}

GameControls .action-button.disabled,
GameControls .action-button.disabled:hover,
GameControls .action-button.disabled:focus {
    background: $background;
    color: $text-muted;
    text-style: none;
}
